# 环境变量配置模板
# 复制为 .env 并填写实际值: cp .env.example .env && source .env

# ── 硅基流动 API (ASR 转写 + LLM 蒸馏用) ──────────────────────────────────
ASR_API_KEY=
ASR_BASE_URL=https://api.siliconflow.cn/v1
ASR_MODEL=Qwen/Qwen2.5-7B-Instruct

# ── 微博抓取 ────────────────────────────────────────────────────────────────
# Cookie 从浏览器开发者工具 > Application > Cookies > weibo.cn 复制完整字符串
WEIBO_COOKIE=
WEIBO_UID=6231346896
# 输出路径(支持相对路径,相对于仓库根目录)
WEIBO_OUTPUT=local_file/小饭-微博-自动抓取.md

# ── B站下载 ─────────────────────────────────────────────────────────────────
BILI_COOKIE_PATH=/tmp/bili_cookie.txt
BILI_OUTPUT_DIR=raw/xiaofan_new_clips

# ── Gemini (test_persona.py 评测用) ─────────────────────────────────────────
# GOOGLE_API_KEY=  # 使用 google-genai SDK 默认认证方式